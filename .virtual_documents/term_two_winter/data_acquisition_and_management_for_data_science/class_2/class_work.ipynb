# Import the library
import psycopg2 as db

# Initialize connection
conn = None

try:
    # Create a connection string that contains the host, database, username, and password
    conn = db.connect("host=localhost dbname=suppliers user=postgres password=postgres")
    
    # Create the cursor from the connection
    cur = conn.cursor()
    
    # Perform any database operations here (e.g., query execution)
    
    # Close the cursor
    cur.close()
    
except db.Error as e:
    print(f"Error: {e}")
    
finally:
    # Close the connection
    if conn is not None:
        conn.close()




