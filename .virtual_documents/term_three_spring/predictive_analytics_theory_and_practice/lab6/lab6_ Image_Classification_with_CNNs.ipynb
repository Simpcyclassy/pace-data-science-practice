





# system & utils
import os, zipfile, random

# data & plotting
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# core TensorFlow for lower-level stuff (if you need it)
import tensorflow as tf
print("TensorFlow version:", tf.__version__)

# standalone Keras
import keras
