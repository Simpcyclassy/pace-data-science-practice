    }
    
    print(f"{dataset_name}:")
    print(f"  Best method: {best_method_name}")
    print(f"  Best silhouette score: {best_score:.4f}")
    print(f"  Optimal clusters: k = {optimal_k_values[dataset_name]}")

# Dataset characteristics analysis
